# Amazon SP-API 凭证
# 从 Seller Central > 开发者中心 获取
SP_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxx
SP_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxxxxxxxxxx

# 多店铺配置（JSON 格式）
# key = 店铺名称（自定义），value = refresh_token（OAuth 授权后获取）
SP_STORES={"my_store":"Atzr|xxxxxxxx"}

# 默认店铺名称（可选，只有一个店铺时自动选择）
SP_DEFAULT_STORE=my_store

# 写操作安全开关，默认不要开启
# 开启后 update_listing / update_price / send_solicitation 会修改真实亚马逊店铺数据
SP_ENABLE_WRITE_ACTIONS=false
